{
  "openapi": "3.1.0",
  "info": {
    "title": "SystemPrompts public API",
    "version": "0.1.0",
    "description": "Read-only JSON endpoints for the SystemPrompts archive. No authentication is required."
  },
  "servers": [
    {
      "url": "https://www.systemprompts.fun",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/prompts": {
      "get": {
        "summary": "List indexed prompts",
        "operationId": "listPrompts",
        "responses": {
          "200": {
            "description": "JSON object with an `items` array of prompt index entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/prompt": {
      "get": {
        "summary": "Fetch prompt file content",
        "operationId": "getPrompt",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Relative path under src/prompts (from the internal file map)"
          }
        ],
        "responses": {
          "200": {
            "description": "Prompt body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing path" },
          "403": { "description": "Invalid path" },
          "404": { "description": "File not found" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "service": { "type": "string" },
                    "ts": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/x402/premium": {
      "get": {
        "summary": "x402-gated premium JSON (HTTP 402 when unpaid)",
        "description": "Uses @x402/next with facilitator https://facilitator.x402.org (override via X402_FACILITATOR_URL). Unpaid requests receive HTTP 402 with machine-readable payment requirements per https://x402.org. Set X402_PAY_TO to your wallet; if unset, a discovery placeholder payTo is used so agents still see 402.",
        "operationId": "x402Premium",
        "responses": {
          "200": {
            "description": "Paid or waived response body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "message": { "type": "string" },
                    "free_apis": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "502": {
            "description": "Facilitator error (x402 settlement/verify)"
          }
        }
      }
    }
  }
}
